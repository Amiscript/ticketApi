# Copy to .env and edit.
DEBUG=true
SECRET_KEY=replace-with-python-secrets-token_urlsafe-48
DATABASE_URL=postgresql+psycopg://ticketflow:ticketflow@localhost:5432/ticketflow
AUTO_CREATE_TABLES=true

# mock only works with DEBUG=true. Use paystack in production.
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tickets@ticketflow.local
